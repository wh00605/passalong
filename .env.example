# Copy to .env and fill in. Every value marked REQUIRED must be set in production.
# Anything left blank disables that integration and the site shows a clear "not configured" state.

# ── Core ───────────────────────────────────────────────────────────────
# REQUIRED. Public base URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# REQUIRED. Postgres connection string (Supabase: use the pooled "Transaction" URL for the app).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/passalong
# Supabase direct (non-pooled) URL, used only by `prisma migrate deploy`.
DIRECT_DATABASE_URL=
# REQUIRED. 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-in-production
# REQUIRED. 32 bytes base64 – encrypts tax IDs at rest.
DATA_ENCRYPTION_KEY=
# REQUIRED. Random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# ── Sign-in providers (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple needs a paid Apple Developer account. APPLE_CLIENT_SECRET is the signed JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ── Stripe (TEST MODE keys only until go-live) ─────────────────────────
# Safety latch: the app refuses sk_live_ keys in production unless this is "true".
STRIPE_LIVE_MODE_APPROVED=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook secret for the Connect (connected accounts) endpoint
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Storage (Supabase) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for listing photos, private bucket for chat/dispute evidence
SUPABASE_PUBLIC_BUCKET=listing-photos
SUPABASE_PRIVATE_BUCKET=private-uploads
# Local dev without Supabase: files are written to ./.uploads and served by /api/files
LOCAL_UPLOADS=true

# ── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Passalong <hello@passalong.co.uk>"
# Where support/contact-form messages are delivered
SUPPORT_EMAIL=support@passalong.co.uk

# ── Shipping (Shippo) ──────────────────────────────────────────────────
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_SECRET=

# ── Web push (generate: npx web-push generate-vapid-keys) ──────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@passalong.co.uk

# ── Testing / CI only ──────────────────────────────────────────────────
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/passalong_test
# ALLOW_DEV_EMAIL=true   # write emails to ./.emails even in a production build (CI e2e only)
# DISABLE_RATE_LIMIT=true

# ── Rate limiting (Upstash Redis). Falls back to Postgres if blank. ────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
